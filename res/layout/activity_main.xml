<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- ══ 状态 ══ -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadge"
                    style="@style/Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检测中…"
                    android:textColor="@color/text_dim" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvCurrent"
                    style="@style/Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />

                <TextView
                    android:id="@+id/tvCurrentMax"
                    style="@style/Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ —" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMode"
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正在探测模块与亮度节点…" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke" />

            <TextView
                android:id="@+id/tvNode"
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="亮度节点：—" />

            <TextView
                android:id="@+id/tvModule"
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模块：—" />

            <TextView
                android:id="@+id/tvError"
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/err"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ══ 亮度滑条 ══ -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="磁贴锁定亮度" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tvTarget"
                    style="@style/Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />

                <TextView
                    android:id="@+id/tvTargetPct"
                    style="@style/Unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:min="1"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/brand"
                android:thumbTint="@color/brand" />

            <TextView
                android:id="@+id/tvTargetRange"
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="可调范围 0 – —" />

            <TextView
                android:id="@+id/btnMax"
                style="@style/ButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="使用亮度上限" />
        </LinearLayout>

        <!-- ══ 锁定开关 ══ -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="锁定" />

            <TextView
                android:id="@+id/btnToggle"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="锁定亮度" />

            <TextView
                android:id="@+id/tvLockHint"
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="点击快捷设置磁贴即可随时锁定" />

            <TextView
                android:id="@+id/btnApply"
                style="@style/ButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="立即写入一次（不改变锁定状态）" />
        </LinearLayout>

        <!-- ══ 行为设置 ══ -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="行为" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="解锁时恢复原亮度" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="关闭后解锁只是停止保持，亮度停在当前值" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swRestore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="同步模块峰值亮度" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="把模块的 max_bri 拉到磁贴亮度，避免模块守护进程二次提升；解锁时还原" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="持续保持" />

                    <TextView
                        style="@style/RowHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="常驻通知并周期性拉回亮度，适合开启自动亮度的设备；关闭时只需写一次" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swKeepAlive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvIntervalLabel"
                style="@style/RowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="保持间隔" />

            <SeekBar
                android:id="@+id/seekInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="15"
                android:progress="2"
                android:progressTint="@color/brand"
                android:thumbTint="@color/brand" />

            <TextView
                android:id="@+id/tvInterval"
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.5 秒" />
        </LinearLayout>

        <!-- ══ 维护 ══ -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="维护" />

            <TextView
                android:id="@+id/btnRoot"
                style="@style/ButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="申请 Root 权限" />

            <TextView
                android:id="@+id/btnProbe"
                style="@style/ButtonGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="重新探测模块与节点" />
        </LinearLayout>

        <!-- ══ 日志 ══ -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="运行日志" />

                <TextView
                    android:id="@+id/btnCopyLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="复制"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="清空"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/logScroll"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface_alt"
                android:padding="10dp">

                <TextView
                    android:id="@+id/tvLog"
                    style="@style/LogView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="等待操作…" />
            </ScrollView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="LuminPro 磁贴 · 配合 LuminPro V2.5.0 使用"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
