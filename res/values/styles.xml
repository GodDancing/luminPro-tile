<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="RowLabel">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RowHint">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="Value">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Unit">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Badge">
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/bg_badge</item>
    </style>

    <style name="Button">
        <item name="android:textSize">15sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ButtonPrimary" parent="Button">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ButtonGhost" parent="Button">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="LogView">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

</resources>
